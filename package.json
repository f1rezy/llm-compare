{
    "name": "llm-compare",
    "version": "1.0.0",
    "description": "",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "lint": "npm run lint --workspaces",
        "lint:ci": "npm run lint:ci --workspaces",
        "lint:fix": "npm run lint:fix --workspaces",
        "typecheck": "npm run typecheck --workspaces",
        "typecheck:ci": "npm run typecheck:ci --workspaces",
        "build:frontend": "npm run build -w @llm-compare/frontend",
        "dev:backend": "npm run dev -w @llm-compare/backend",
        "dev:frontend": "npm run dev -w @llm-compare/frontend"
    },
    "workspaces": [
        "common",
        "backend",
        "frontend"
    ],
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.10.1"
    }
}
